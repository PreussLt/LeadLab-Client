{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeadLab",
  "mainBinaryName": "leadlab-client",
  "version": "../package.json",
  "identifier": "de.leadlab.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "LeadLab",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https: http:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Arbeitsplatz-Client für Vanguard LeadLab",
    "longDescription": "Verbindet den Arbeitsplatz mit einem LeadLab-Server und hält Gelände-, Karten-, Luftbild- und Gebäudedaten lokal vor.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["German"] },
      "wix": { "language": "de-DE" }
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    }
  }
}
